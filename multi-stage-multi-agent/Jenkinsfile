pipeline {
    agent none

    stages {
        stage('Back-end') {
            agent {
                docker {
                    image 'maven:3.8.1-adoptopenjdk-11'
                }
            }
            steps {
                sh 'mvn --version'
            }
        }

        stage('Front-end') {
            agent {
                docker {
                    image 'node:16-alpine'
                }
            }
            steps {
                sh 'node --version'
            }
        }

        stage('Deploy') {
            agent any
            steps {
                sh '''
                    docker rm -f node-app || true
                    docker run -d \
                        --name node-app \
                        -p 8081:8080 \
                        node:16-alpine
                '''
            }
        }
    }
}

